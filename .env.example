# Copy to .env (never commit .env). Each person uses their OWN AI Studio key (rate limits are per project).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # used when LLM_MODEL is empty
# LLM switch (shared/llm.py): "gemini-..." (GOOGLE_API_KEY) or "openai/<model>" (OpenAI-compatible, e.g. UniGPT)
LLM_MODEL=openai/DeepSeek-V4-Flash     # concierge, curator, enrollment
LLM_SMALL_MODEL=openai/DeepSeek-V4-Flash  # scouts, guard, price extraction (default gemini-3.5-flash-lite)
UNIGPT_BASE_URL=https://gpt.uni-muenster.de/v1
UNIGPT_API_KEY=

DEMO_MODE=fixtures                     # fixtures | live (live needs APIFY_TOKEN)
APIFY_TOKEN=
FIRECRAWL_API_KEY=                     # optional: resolver fallback for ticket shops that block plain HTTP (max 10 pages/h)

GUARD=gemini                           # gemini = LLM guard with LLM_SMALL_MODEL | model_armor (needs GCP billing + `uv sync --extra gcp`)
GOOGLE_CLOUD_PROJECT=
MODEL_ARMOR_TEMPLATE=projects/<project>/locations/europe-west1/templates/event-scout

DEMO_FORM_URL=                         # P4: Google Form of the demo event (.../formResponse)
ENROLLMENT_A2A_URL=http://localhost:8001
