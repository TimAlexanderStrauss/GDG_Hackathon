# Copy to .env.local (optional). No secrets here.
CONCIERGE_URL=http://localhost:8000/
COPILOTKIT_TELEMETRY_DISABLED=true

# Google sign-in (Phase 3, Auth.js). Put real values only in web/.env.local (git ignores it).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random string, e.g.: openssl rand -base64 32
AUTH_SECRET=
